<ui:FluentWindow x:Class="Insta360StudioWireless.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:Insta360StudioWireless.ViewModels"
        xmlns:conv="clr-namespace:Insta360StudioWireless.Converters"
        mc:Ignorable="d"
        Title="Photos - Insta360 ONE RS" 
        Icon="Assets/app_logo.png"
        Height="880" Width="1380"
        MinHeight="600" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Background="#0E0E10"
        Foreground="#E8EAED">

    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVis" Invert="True" />
        <conv:NullToVisibilityConverter x:Key="NotNullToVis" Invert="False" />
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" Invert="False" />
        <conv:BooleanToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />

        <!-- Google Photos Pill Button Style with smooth hover animations -->
        <Style x:Key="GooglePillButtonStyle" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Background" Value="#222328"/>
            <Setter Property="Foreground" Value="#E8EAED"/>
            <Setter Property="BorderBrush" Value="#383942"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#30323A"/>
                    <Setter Property="BorderBrush" Value="#5F6368"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Blue Pill Accent Button -->
        <Style x:Key="GoogleBluePillStyle" TargetType="Button" BasedOn="{StaticResource GooglePillButtonStyle}">
            <Setter Property="Background" Value="#1A73E8"/>
            <Setter Property="BorderBrush" Value="#4285F4"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1B66C9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Circular Action Button (Google Photos Style) -->
        <Style x:Key="GoogleCircleButtonStyle" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Background" Value="#4D202124"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20" Width="40" Height="40">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#803C4043"/>
                    <Setter Property="BorderBrush" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Google Photos / YouTube Video Scrubber Slider Style -->
        <Style x:Key="GoogleVideoSliderStyle" TargetType="Slider">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="24" Background="Transparent">
                            <!-- Background Unplayed Track (Clearly visible light gray bar) -->
                            <Border x:Name="BgTrack" Height="4" CornerRadius="2" Background="#5F6368" VerticalAlignment="Center" Margin="0"/>
                            
                            <!-- Track with Progress and Thumb -->
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton IsHitTestVisible="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="4" CornerRadius="2" Background="#1A73E8" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Grid Width="20" Height="20">
                                                    <Ellipse Width="14" Height="14" Fill="#FFFFFF">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.5" Color="#000000"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton IsHitTestVisible="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="4" Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#0E0E10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- SINGLE TOP BAR (TitleBar with TrailingContent)          -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Background="#141418">
            <ui:TitleBar x:Name="AppTitleBar" Title="Photos - Insta360 ONE RS" Icon="Assets/app_logo.png" Foreground="#E8EAED" ButtonsForeground="#FFFFFF" Height="44">
                <ui:TitleBar.TrailingContent>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Status Badge -->
                        <Border Background="#1E1F24" BorderBrush="{Binding ConnectionBadgeColor}" BorderThickness="1" 
                                CornerRadius="13" Padding="10,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{Binding ConnectionBadgeColor}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding StatusText}" Foreground="#D0D0D4" FontSize="11" FontWeight="SemiBold" 
                                           MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- Refresh Button (Only visible when connected) -->
                        <Button Command="{Binding RefreshGalleryCommand}" ToolTip="Refresh camera footage" 
                                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource GooglePillButtonStyle}" Padding="10,4" FontSize="11" Margin="0,0,8,0"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="OnRefreshButtonClicked"
                                PreviewMouseLeftButtonDown="OnRefreshButtonClicked">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowSync20" Margin="0,0,6,0" FontSize="13"/>
                                <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Disconnect Button (Only visible when connected) -->
                        <Button Command="{Binding DisconnectCommand}" Margin="0,0,8,0"
                                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource GooglePillButtonStyle}" Padding="10,4" FontSize="11"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="OnDisconnectButtonClicked"
                                PreviewMouseLeftButtonDown="OnDisconnectButtonClicked">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="PlugDisconnected20" Margin="0,0,6,0" FontSize="13"/>
                                <TextBlock Text="Disconnect" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Save Folder Pill Button with Browse -->
                        <Button Command="{Binding BrowseDownloadFolderCommand}"
                                Style="{StaticResource GooglePillButtonStyle}"
                                Padding="10,4" FontSize="11"
                                ToolTip="Click to change footage download folder"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="OnBrowseFolderClicked"
                                PreviewMouseLeftButtonDown="OnBrowseFolderClicked">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Folder20" Foreground="#8AB4F8" Margin="0,0,6,0" FontSize="13"/>
                                <TextBlock Text="{Binding DownloadFolder}" Foreground="#E8EAED" FontSize="11" Margin="0,0,8,0"/>
                                <Border Background="#25FFFFFF" CornerRadius="8" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="Browse" FontSize="10" Foreground="#A8C7FA" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ui:TitleBar.TrailingContent>
            </ui:TitleBar>
        </Grid>

        <!-- ======================================================== -->
        <!-- GOOGLE PHOTOS TIMELINE (Grouped by Date)                 -->
        <!-- ======================================================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,20,28,30">
            <ItemsControl ItemsSource="{Binding DateGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Date Section Group -->
                        <StackPanel Margin="0,0,0,26">
                            <!-- Date Section Header (Exact Google Photos Style) -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,10">
                                <!-- Select Indicator Circle -->
                                <Border Width="22" Height="22" CornerRadius="11" BorderBrush="#5F6368" BorderThickness="1.5" 
                                        Background="Transparent" Margin="0,0,10,0" VerticalAlignment="Center" Cursor="Hand">
                                    <ui:SymbolIcon Symbol="Checkmark16" FontSize="11" Foreground="#5F6368" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                                </Border>
                                
                                <!-- Formatted Date Text: e.g. "Sun, Aug 30" -->
                                <TextBlock Text="{Binding DateHeader}" FontSize="15" FontWeight="SemiBold" 
                                           Foreground="#FFFFFF" VerticalAlignment="Center"/>

                                <!-- Item Count -->
                                <TextBlock Text="{Binding ItemCount, StringFormat='{}• {0}'}" FontSize="13" 
                                           Foreground="#9AA0A6" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Photo & Video Tile Grid (Seamless WrapPanel, 4px gap) -->
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Google Photos Media Tile with smooth hover animations -->
                                        <Border x:Name="MediaCard" Width="260" Height="175" Margin="0,0,6,6" CornerRadius="6" ClipToBounds="True"
                                                Background="#16161B" Cursor="Hand"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                            </Border.RenderTransform>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Trigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                                         To="1.025" Duration="0:0:0.18" DecelerationRatio="0.8"/>
                                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                                         To="1.025" Duration="0:0:0.18" DecelerationRatio="0.8"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.EnterActions>
                                                            <Trigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                                         To="1.0" Duration="0:0:0.18" AccelerationRatio="0.8"/>
                                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                                         To="1.0" Duration="0:0:0.18" AccelerationRatio="0.8"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.ExitActions>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick" 
                                                              Command="{Binding DataContext.OpenVideoPopupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}" />
                                            </Border.InputBindings>

                                            <Grid>
                                                <!-- Media Thumbnail -->
                                                <Image Source="{Binding ThumbnailBitmap}" Stretch="UniformToFill"
                                                       Visibility="{Binding ThumbnailBitmap, Converter={StaticResource NotNullToVis}}"/>

                                                <!-- Video / No-Thumbnail Backdrop -->
                                                <Border Background="#16161B"
                                                        Visibility="{Binding ThumbnailBitmap, Converter={StaticResource NullToVis}}">
                                                    <Grid>
                                                        <ui:SymbolIcon Symbol="Video24" FontSize="36" Foreground="#383842" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Border Width="44" Height="44" CornerRadius="22" Background="#80000000"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="18" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <!-- Top Left: 360° Badge (if 360 media) -->
                                                <Border Background="#CC003366" CornerRadius="4" Padding="6,2" Margin="8" 
                                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                                        Visibility="{Binding Is360, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Globe24" FontSize="11" Foreground="#60CDFF" Margin="0,0,4,0"/>
                                                        <TextBlock Text="360°" FontSize="10" FontWeight="Bold" Foreground="#60CDFF"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Top Right: Video Duration Badge (Exact Google Photos Style: "0:06 ▶") -->
                                                <Border Background="#B3000000" CornerRadius="10" Padding="8,3" Margin="8"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FormattedDuration}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,5,0"/>
                                                        <ui:SymbolIcon Symbol="Play16" Filled="True" FontSize="10" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Bottom Gradient Vignette & Info -->
                                                <Border VerticalAlignment="Bottom" Height="36">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#00000000" Offset="0.0"/>
                                                            <GradientStop Color="#B3000000" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Grid Margin="8,0,8,6" VerticalAlignment="Bottom">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <!-- File size -->
                                                        <TextBlock Grid.Column="0" Text="{Binding FormattedSize}" FontSize="11" 
                                                                   FontWeight="SemiBold" Foreground="#D0D0D4" VerticalAlignment="Center"/>

                                                        <!-- Telemetry status dot -->
                                                        <TextBlock Grid.Column="1" Text="{Binding TelemetryStatusText}" FontSize="10" 
                                                                   Foreground="{Binding TelemetryStatusColor}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Hover Overlay (Download & Select) with smooth fade animation -->
                                                <Grid x:Name="HoverOverlay" Opacity="0">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" DecelerationRatio="0.9"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                    <DataTrigger.ExitActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" AccelerationRatio="0.9"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.ExitActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>

                                                    <!-- Top-left select circle -->
                                                    <Border Width="22" Height="22" CornerRadius="11" BorderBrush="#FFFFFF" BorderThickness="1.5"
                                                            Background="#40000000" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                                                        <ui:SymbolIcon Symbol="Checkmark16" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- Bottom-right Quick Download Button -->
                                                    <Button Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                                                            Style="{StaticResource GoogleCircleButtonStyle}"
                                                            Command="{Binding DataContext.DownloadMediaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Download to PC">
                                                        <ui:SymbolIcon Symbol="ArrowDownload16" FontSize="14" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ======================================================== -->
        <!-- FLOATING CONNECTION MODAL (Blocks gallery when disconnected) -->
        <!-- ======================================================== -->
        <Grid Grid.Row="1"
              Background="#DF08080C"
              Visibility="{Binding IsConnected, Converter={StaticResource InvertBoolToVis}}">
            
            <Border Width="460" Background="#16161A" CornerRadius="16" 
                    BorderBrush="#2C2C34" BorderThickness="1"
                    Padding="36,32" HorizontalAlignment="Center" VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Direction="270" ShadowDepth="10" Opacity="0.6" Color="#000000"/>
                </Border.Effect>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsVisible" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" DecelerationRatio="0.8"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="0.95" To="1.0" Duration="0:0:0.22" DecelerationRatio="0.8"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" From="0.95" To="1.0" Duration="0:0:0.22" DecelerationRatio="0.8"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel HorizontalAlignment="Center">
                    <!-- Icon -->
                    <Border Width="68" Height="68" CornerRadius="34" Background="#1F1F26" 
                            BorderBrush="#383844" BorderThickness="1"
                            HorizontalAlignment="Center" Margin="0,0,0,18">
                        <ui:SymbolIcon Symbol="Camera24" FontSize="32" Foreground="#4285F4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Title -->
                    <TextBlock Text="Connect to Insta360" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" 
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Connect your PC to the camera's Wi-Fi hotspot to view and offload footage." 
                               FontSize="13" Foreground="#9AA0A6" TextWrapping="Wrap" TextAlignment="Center" 
                               MaxWidth="360" Margin="0,0,0,22"/>

                    <!-- Camera IP Input -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Camera IP Address" FontSize="11" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,0,0,6"/>
                        <Border Background="#202126" CornerRadius="8" 
                                BorderBrush="#383842" BorderThickness="1" Padding="12,6">
                            <Grid>
                                <TextBox Text="{Binding CameraIp, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" FontSize="14" 
                                         FontFamily="Consolas" VerticalAlignment="Center" CaretBrush="#FFFFFF"/>
                                <TextBlock Text="Default: 192.168.42.1" Foreground="#5F6368" FontSize="11" 
                                           HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Status message -->
                    <Border Background="#1F1F24" CornerRadius="8" Padding="14,10" Margin="0,0,0,20"
                            BorderBrush="{Binding ConnectionBadgeColor}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{Binding ConnectionBadgeColor}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding StatusText}" Foreground="#E0E0E6" FontSize="12" 
                                       TextWrapping="Wrap" MaxWidth="340" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Connect Button -->
                    <Button Height="44" 
                            Command="{Binding ConnectCommand}"
                            Click="OnConnectButtonClicked"
                            PreviewMouseLeftButtonDown="OnConnectButtonClicked"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolToVis}}"
                            Style="{StaticResource GoogleBluePillStyle}" FontSize="14" FontWeight="Bold" 
                            HorizontalAlignment="Stretch" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Camera24" Margin="0,0,8,0" FontSize="18"/>
                            <TextBlock Text="Connect Camera" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Wi-Fi Tips -->
                    <TextBlock Text="Tip: Enable Wi-Fi on your ONE RS • Default password is usually 88888888" 
                               FontSize="11" Foreground="#70757A" HorizontalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- GOOGLE PHOTOS FULLSCREEN LIGHTBOX PLAYER                -->
        <!-- ======================================================== -->
        <Grid Grid.Row="1"
              Background="#F2000000"
              Visibility="{Binding IsPlayerPopupOpen, Converter={StaticResource BoolToVis}}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <Trigger Property="Visibility" Value="Visible">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" DecelerationRatio="0.9"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top Floating Action Bar -->
                <Border Grid.Row="0" Background="#E6101014" BorderBrush="#25252A" BorderThickness="0,0,0,1" Padding="20,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Back Button & Media Title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GoogleCircleButtonStyle}" Width="42" Height="42" Margin="0,0,14,0"
                                    Click="OnBackButtonClicked"
                                    PreviewMouseLeftButtonDown="OnBackButtonClicked"
                                    Command="{Binding CloseVideoPopupCommand}" ToolTip="Back to Photos (Esc)">
                                <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="18" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActivePlayingMedia.FileName}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="{Binding ActivePlayingMedia.FormattedDateDetail}" FontSize="11" Foreground="#9AA0A6"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Telemetry Status & File Size -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Background="#202126" CornerRadius="12" Padding="12,4" Margin="0,0,10,0">
                                <TextBlock Text="{Binding ActivePlayingMedia.FormattedSize}" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                            </Border>
                            <Border Background="#202126" CornerRadius="12" Padding="12,4">
                                <TextBlock Text="{Binding ActivePlayingMedia.TelemetryStatusText}" FontSize="12" FontWeight="SemiBold" 
                                           Foreground="{Binding ActivePlayingMedia.TelemetryStatusColor}"/>
                            </Border>
                        </StackPanel>

                        <!-- Right Actions: Download & Close -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GoogleBluePillStyle}" Margin="0,0,12,0"
                                    Command="{Binding DownloadMediaCommand}" CommandParameter="{Binding ActivePlayingMedia}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="ArrowDownload24" Margin="0,0,8,0" FontSize="16"/>
                                    <TextBlock Text="Download to PC" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GoogleCircleButtonStyle}" Width="42" Height="42"
                                    Click="OnBackButtonClicked"
                                    PreviewMouseLeftButtonDown="OnBackButtonClicked"
                                    Command="{Binding CloseVideoPopupCommand}" ToolTip="Close (Esc)">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="18" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Center Media Viewport with Prev / Next Controls -->
                <Grid Grid.Row="1" Background="#000000">
                    <!-- Video Player Element -->
                    <MediaElement x:Name="PopupPlayer"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Stop"
                                  MediaOpened="OnPlayerMediaOpened"
                                  MediaEnded="OnPlayerMediaEnded"
                                  Stretch="Uniform"
                                  Visibility="{Binding ActivePlayingMedia.IsVideo, Converter={StaticResource BoolToVis}}"/>

                    <!-- Photo Viewer -->
                    <Image Source="{Binding ActivePlayingMedia.RemoteUrl}"
                           Stretch="Uniform"
                           Visibility="{Binding ActivePlayingMedia.IsPhoto, Converter={StaticResource BoolToVis}}"/>

                    <!-- Previous Media Arrow (Left) -->
                    <Button HorizontalAlignment="Left" VerticalAlignment="Center" Margin="24,0,0,0"
                            Width="48" Height="48" Style="{StaticResource GoogleCircleButtonStyle}"
                            Command="{Binding PreviousMediaCommand}" ToolTip="Previous (Left Arrow)">
                        <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="22" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Next Media Arrow (Right) -->
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0"
                            Width="48" Height="48" Style="{StaticResource GoogleCircleButtonStyle}"
                            Command="{Binding NextMediaCommand}" ToolTip="Next (Right Arrow)">
                        <ui:SymbolIcon Symbol="ChevronRight24" FontSize="22" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Optional Telemetry HUD Overlay (Top-Right of video) -->
                    <Border Background="#CC0E0E12" CornerRadius="8" Padding="14,10" 
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20"
                            BorderBrush="#303038" BorderThickness="1"
                            Visibility="{Binding ActivePlayingMedia.HasGps, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Text="SPEED" FontSize="9" FontWeight="Bold" Foreground="#888894"/>
                                <TextBlock Text="{Binding CurrentSpeedKmh, StringFormat='{}{0:F1} km/h'}" FontSize="16" FontWeight="Bold" Foreground="#4CC2FF"/>
                            </StackPanel>
                            <Separator Background="#303038" Margin="0,0,14,0"/>
                            <StackPanel>
                                <TextBlock Text="ALTITUDE" FontSize="9" FontWeight="Bold" Foreground="#888894"/>
                                <TextBlock Text="{Binding CurrentAltitudeMeters, StringFormat='{}{0:F1} m'}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Bottom Floating Timeline Player Bar (for Videos) -->
                <Border Grid.Row="2" Background="#E6101014" BorderBrush="#25252A" BorderThickness="0,1,0,0" Padding="24,14"
                        Visibility="{Binding ActivePlayingMedia.IsVideo, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Play / Pause Button -->
                        <Button Grid.Column="0" Width="44" Height="36" Style="{StaticResource GoogleBluePillStyle}" Margin="0,0,16,0"
                                Command="{Binding TogglePlayPauseCommand}">
                            <Grid>
                                <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="16" Foreground="#FFFFFF"
                                               Visibility="{Binding IsPlaying, Converter={StaticResource InvertBoolToVis}}"/>
                                <ui:SymbolIcon Symbol="Pause24" Filled="True" FontSize="16" Foreground="#FFFFFF"
                                               Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Button>

                        <!-- Timeline Scrubber Slider -->
                        <Slider x:Name="PlayerSlider" Grid.Column="1" 
                                Style="{StaticResource GoogleVideoSliderStyle}"
                                Value="{Binding PlayerCurrentSeconds}" 
                                Maximum="{Binding PlayerTotalSeconds}"
                                VerticalAlignment="Center" Margin="0,0,16,0"
                                ValueChanged="OnTimelineSliderValueChanged"
                                PreviewMouseDown="OnTimelineSliderPreviewMouseDown"
                                PreviewMouseMove="OnTimelineSliderPreviewMouseMove"
                                PreviewMouseUp="OnTimelineSliderPreviewMouseUp"/>

                        <!-- Current Time / Total Time -->
                        <TextBlock Grid.Column="2" Text="{Binding PlayerTimeText}" 
                                   VerticalAlignment="Center" FontWeight="Bold" Foreground="#CCCCCC" FontSize="13" Margin="0,0,18,0"/>

                        <!-- GPX Export (if GPS track exists) -->
                        <Button Grid.Column="3" Style="{StaticResource GooglePillButtonStyle}"
                                Command="{Binding ExportGpxCommand}"
                                Visibility="{Binding ActivePlayingMedia.HasGps, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Share24" Margin="0,0,6,0" FontSize="14"/>
                                <TextBlock Text="Export GPX" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
